+// Stable per-profile application UUID, without a console identity or a network service.
+static void ov_pseudo_device_id(Cpu *c) {
+    void *out = arg_p(c, 0);
+    if (!out) rt_fatal("nn::oe::GetPseudoDeviceId: null output");
+    uint64_t seed[3] = {0, 0, RT_APPLICATION_ID};
+    uint8_t hash[32];
+    account_uid(seed);
+    rt_sha256(seed, sizeof seed, hash);
+    hash[6] = (hash[6] & 0x0f) | 0x80;
+    hash[8] = (hash[8] & 0x3f) | 0x80;
+    memcpy(out, hash, 16);
+    ret_x(c, 0);
+}
