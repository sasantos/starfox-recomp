+// In-process IPv4 loopback streams for the game's I/O wakeups. A connect can only reach a listener in this table.
+enum { BSD_FIRST_FD = 3, BSD_FDS = 64, BSD_PIPE_SIZE = 4096 };
+enum { BSD_EBADF = 9, BSD_EAGAIN = 11, BSD_EINVAL = 22, BSD_EMFILE = 24, BSD_EPIPE = 32, BSD_ENOTSUP = 95,
+       BSD_EADDRINUSE = 98, BSD_ENETDOWN = 100, BSD_ENOTCONN = 107, BSD_ECONNREFUSED = 111 };
+typedef struct { uint8_t len, family, port[2], address[4], pad[8]; } BsdAddress;
+typedef struct {
+    int used, listening, flags, peer, pending;
+    int connected;
+    uint16_t port, remote_port;
+    unsigned bytes;
+    uint8_t data[BSD_PIPE_SIZE];
+} BsdLocal;
+static BsdLocal bsd_fds[BSD_FDS];
+static PlatMutex bsd_lock = PLAT_MUTEX_INIT;
+
+static BsdLocal *bsd_fd(int fd) { // under bsd_lock
+    if (fd < BSD_FIRST_FD || fd >= BSD_FIRST_FD + BSD_FDS || !bsd_fds[fd - BSD_FIRST_FD].used) return NULL;
+    return &bsd_fds[fd - BSD_FIRST_FD];
+}
+
+static int bsd_alloc(void) {
+    for (int i = 0; i < BSD_FDS; i++) if (!bsd_fds[i].used) {
+        bsd_fds[i] = (BsdLocal){.used = 1};
+        return BSD_FIRST_FD + i;
+    }
+    return -BSD_EMFILE;
+}
+
+static int bsd_port_in_use(uint16_t port) {
+    for (int i = 0; i < BSD_FDS; i++) if (bsd_fds[i].used && bsd_fds[i].port == port) return 1;
+    return 0;
+}
+
+static uint16_t bsd_ephemeral(void) {
+    for (unsigned port = 49152; port < 49152 + BSD_FDS; port++)
+        if (!bsd_port_in_use((uint16_t)port)) return (uint16_t)port;
+    return 0;
+}
+
+static IpcBuffer bsd_buffer(const IpcRequest *rq, int out) {
+    if (out) return rq->nb && rq->b[0].size ? rq->b[0] : rq->nc ? rq->c[0] : (IpcBuffer){0};
+    return rq->na && rq->a[0].size ? rq->a[0] : rq->nx ? rq->x[0] : (IpcBuffer){0};
+}
+
+static void bsd_output(const IpcRequest *rq, IpcResponse *rs, IpcBuffer out, const void *src, unsigned size) {
+    if (!size) return;
+    memcpy(ipc_guest(out.addr, size), src, size);
+    if (!rq->nb || !rq->b[0].size) rs->xout[rs->nxout++] = (IpcBuffer){out.addr, size, 0};
+}
+
+static int bsd_endpoint(const IpcRequest *rq, BsdLocal *socket) {
+    IpcBuffer in = bsd_buffer(rq, 0);
+    if (in.size < sizeof(BsdAddress)) return -BSD_EINVAL;
+    BsdAddress addr;
+    memcpy(&addr, ipc_guest(in.addr, sizeof addr), sizeof addr);
+    const uint8_t localhost[4] = {127, 0, 0, 1}, wildcard[4] = {0};
+    int bind = rq->cmd == 13;
+    if (addr.family != 2 || (memcmp(addr.address, localhost, 4) && (!bind || memcmp(addr.address, wildcard, 4))))
+        return -BSD_ENETDOWN;
+    uint16_t port = (uint16_t)((addr.port[0] << 8) | addr.port[1]);
+    if (bind) {
+        if (socket->port) return -BSD_EINVAL;
+        if (!port) port = bsd_ephemeral();
+        if (!port || bsd_port_in_use(port)) return -BSD_EADDRINUSE;
+        socket->port = port;
+        return 0;
+    }
+    if (socket->connected || socket->listening) return -BSD_EINVAL;
+    BsdLocal *listener = NULL;
+    for (int i = 0; i < BSD_FDS; i++)
+        if (bsd_fds[i].listening && bsd_fds[i].port == port) { listener = &bsd_fds[i]; break; }
+    if (!listener || listener->pending) return -BSD_ECONNREFUSED;
+    if (!socket->port) socket->port = bsd_ephemeral();
+    if (!socket->port) return -BSD_EADDRINUSE;
+    int child_fd = bsd_alloc();
+    if (child_fd < 0) return child_fd;
+    BsdLocal *child = bsd_fd(child_fd);
+    socket->peer = child_fd;
+    socket->connected = child->connected = 1;
+    socket->remote_port = child->port = port;
+    child->remote_port = socket->port;
+    child->peer = (int)(socket - bsd_fds) + BSD_FIRST_FD;
+    listener->pending = child_fd;
+    return 0;
+}
+
+static void bsd_close(BsdLocal *socket) {
+    BsdLocal *child = bsd_fd(socket->pending);
+    if (child) bsd_close(child);
+    BsdLocal *peer = bsd_fd(socket->peer);
+    if (peer) peer->peer = 0;
+    *socket = (BsdLocal){0};
+}
