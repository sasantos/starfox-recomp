+    plat_mutex_lock(&lock);
+    OpusManager **link = &managers;
+    while (*link && (*link)->guest != guest) link = &(*link)->next;
+    OpusManager *m = *link;
+    if (m) {
+        for (Decoder *d = decoders; d; d = d->next) {
+            if (d->manager != m) continue;
+            clear_requests(d);
+            d->manager = NULL;
+        }
+        *link = m->next;
+        ST64(guest, 0);
+        kern_forget_system_event(m->event);
+        free(m);
+    }
+    plat_mutex_unlock(&lock);
+}
+
+static void ov_manager_slots(Cpu *c) {
+    plat_mutex_lock_shared(&lock);
+    OpusManager *m = manager_find(arg_x(c, 0));
+    int free_slots = m ? m->slots - m->used : 0;
+    plat_mutex_unlock_shared(&lock);
+    ret_x(c, free_slots);
+}
+
+static void ov_managed_initialize(Cpu *c) {
+    uint64_t guest = arg_x(c, 0);
+    int rate = (int)arg_x(c, 1), channels = (int)arg_x(c, 2);
+    if (!guest || !valid_format(rate, channels)) { ret_x(c, CODEC_R_INVALID); return; }
+    plat_mutex_lock(&lock);
+    OpusManager *m = manager_find(arg_x(c, 4));
+    Decoder *d = decoder_find(guest);
+    if (!m || d) {
+        plat_mutex_unlock(&lock);
+        ret_x(c, CODEC_R_INVALID);
+        return;
+    }
+    d = calloc(1, sizeof *d);
+    if (!d) rt_fatal("nn::codec: managed decoder allocation");
+    d->dec = opus_new(rate, channels);
+    plat_mutex_init(&d->use);
+    d->guest = guest;
+    d->rate = rate;
+    d->channels = channels;
+    d->manager = m;
+    d->next = decoders;
+    decoders = d;
+    plat_mutex_unlock(&lock);
+    ret_x(c, 0);
+}
+
+static void ov_opus_enqueue(Cpu *c) {
+    size_t *consumed = arg_p(c, 1), size = arg_x(c, 3);
+    const uint8_t *in = arg_p(c, 2);
+    if (consumed) *consumed = 0;
+    if (!in || size < 8 || size > OPUS_PACKET_LIMIT + 8 || be32(in) != size - 8) {
+        ret_x(c, CODEC_R_INVALID);
+        return;
+    }
+    plat_mutex_lock(&lock);
+    Decoder *d = decoder_find(arg_x(c, 0));
+    OpusManager *m = d ? d->manager : NULL;
+    if (!m || m->used == m->slots) {
+        plat_mutex_unlock(&lock);
+        ret_x(c, OPUS_R_NO_BUFFER);
+        return;
+    }
+    OpusRequest *r = malloc(sizeof *r);
+    if (!r) rt_fatal("nn::codec: Opus request allocation");
+    r->next = NULL;
+    r->samples = -1;
+    r->packet_size = (int)(size - 8);
+    memcpy(r->packet, in + 8, r->packet_size);
+    if (d->tail) d->tail->next = r;
+    else d->head = r;
+    d->tail = r;
+    d->waiting++;
+    m->used++;
+    plat_mutex_unlock(&lock);
+    if (consumed) *consumed = size;
+    ret_x(c, 0);
+}
+
+static void ov_opus_execute(Cpu *c) {
+    plat_mutex_lock(&lock);
+    OpusManager *m = manager_find(arg_x(c, 0));
+    if (!m) { plat_mutex_unlock(&lock); ret_x(c, CODEC_R_INVALID); return; }
+    int decoded = 0;
+    for (Decoder *d = decoders; d; d = d->next) {
+        if (d->manager != m || !d->waiting) continue;
+        plat_mutex_lock(&d->use);
+        for (OpusRequest *r = d->head; r; r = r->next) {
+            if (r->samples >= 0) continue;
+            int samples = opus_decode(d->dec, r->packet, r->packet_size, r->pcm, OPUS_PCM_SAMPLES / d->channels, 0);
+            if (samples < 0) {
+                static int32_t warned;
+                if (!plat_xchg32(&warned, 1)) rt_log("nn::codec: queued Opus decode: %s", opus_strerror(samples));
+                samples = opus_decode(d->dec, NULL, 0, r->pcm, d->rate / 50, 0);
+                if (samples < 0) rt_fatal("nn::codec: Opus packet concealment failed");
+            }
+            r->samples = samples;
+            d->waiting--;
+            d->completed++;
+            decoded = 1;
+        }
+        release(d);
+    }
+    if (decoded) kern_signal_system_event(m->event);
+    plat_mutex_unlock(&lock);
+    ret_x(c, 0);
+}
+
+static void ov_opus_dequeue(Cpu *c) {
+    int *samples = arg_p(c, 1);
+    int16_t *out = arg_p(c, 2);
+    size_t capacity = arg_x(c, 3);
+    if (samples) *samples = 0;
+    plat_mutex_lock(&lock);
+    Decoder *d = decoder_find(arg_x(c, 0));
+    OpusRequest *r = d && d->completed ? d->head : NULL;
+    size_t bytes = r ? (size_t)r->samples * d->channels * sizeof *out : 0;
+    if (!r || !out || bytes > capacity) { plat_mutex_unlock(&lock); ret_x(c, OPUS_R_NO_BUFFER); return; }
+    d->head = r->next;
+    if (!d->head) d->tail = NULL;
+    d->completed--;
+    d->manager->used--;
+    plat_mutex_unlock(&lock);
+    memcpy(out, r->pcm, bytes);
+    if (samples) *samples = r->samples;
+    free(r);
+    ret_x(c, 0);
+}
+
+static void opus_request_count(Cpu *c, int completed) {
+    plat_mutex_lock_shared(&lock);
+    Decoder *d = decoder_find(arg_x(c, 0));
+    int n = d ? (completed ? d->completed : d->waiting) : 0;
+    plat_mutex_unlock_shared(&lock);
+    ret_x(c, n);
+}
+static void ov_opus_waiting(Cpu *c) { opus_request_count(c, 0); }
+static void ov_opus_completed(Cpu *c) { opus_request_count(c, 1); }
