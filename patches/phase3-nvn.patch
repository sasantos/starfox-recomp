+static void ov_crypto_random(Cpu *c) {
+    uint8_t *out = arg_p(c, 0);
+    uint64_t left = arg_x(c, 1);
+    if (!out && left) rt_fatal("csrng: null output");
+    while (left) {
+        size_t chunk = left > UINT32_MAX ? UINT32_MAX : (size_t)left;
+        if (!plat_random(out, chunk)) rt_fatal("csrng: no random bytes from the system");
+        out += chunk;
+        left -= chunk;
+    }
