+            return (f'{{ const vu8 lhs = {VR("vu8", n)}, rhs = {VR("vu8", m)}; '
+                    f'vu32 acc = {VR("vu32", d)}; '
+                    f'for (unsigned i = 0; i < {lanes(Q, 2)}; ++i) {{ '
+                    'for (unsigned j = 4 * i; j < 4 * i + 4; ++j) acc[i] += (uint32_t)lhs[j] * rhs[j]; } '
+                    f'{VWr("vu32", Q, d, "acc")} }}')
