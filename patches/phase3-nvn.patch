+// SDK 21's virtual output stream runs as a timed sink. It preserves frame capacity and
+// the stopped/started states so Wwise can pace the mixer during a headless boot.
+enum { STREAM_STOPPED = 1, STREAM_STARTED = 2 };
+typedef struct OutputStream {
+    uint64_t guest, event, last_ns;
+    int rate, capacity, queued, state;
+    struct OutputStream *next;
+} OutputStream;
+static OutputStream *streams;
+static PlatMutex stream_lock = PLAT_MUTEX_INIT;
+
+static OutputStream *stream_find(uint64_t guest) { // under stream_lock
+    OutputStream *s = streams;
+    while (s && s->guest != guest) s = s->next;
+    return s;
+}
+
+static void stream_drain(OutputStream *s) { // under stream_lock
+    if (s->state != STREAM_STARTED) return;
+    uint64_t now = kern_now_ns();
+    uint64_t elapsed = now - s->last_ns;
+    uint64_t frames = elapsed / 1000000000ull * s->rate + elapsed % 1000000000ull * s->rate / 1000000000ull;
+    if (frames >= (uint64_t)s->queued) {
+        s->queued = 0;
+        s->last_ns = now;
+    } else {
+        s->queued -= (int)frames;
+        s->last_ns += frames * 1000000000ull / s->rate;
+    }
+}
+
+static void ov_default_output_device(Cpu *c) {
+    static const char name[0x100] = "AudioVirtualOutput";
+    void *out = arg_p(c, 0);
+    if (!out) rt_fatal("nn::audio: null device name");
+    memcpy(out, name, sizeof name);
+}
+
+static void stream_open(Cpu *c, int has_event) {
+    uint64_t guest = arg_x(c, 0), event = has_event ? arg_x(c, 1) : 0;
+    const int32_t *fmt = arg_p(c, has_event ? 5 : 4);
+    int capacity = (int)arg_x(c, has_event ? 6 : 5);
+    if (!guest || !fmt || (fmt[0] != 2 && fmt[0] != 5) || fmt[1] <= 0 ||
+        (fmt[2] != 0 && fmt[2] != 48000) || capacity <= 0) { ret_x(c, CODEC_R_INVALID); return; }
+    plat_mutex_lock(&stream_lock);
+    if (stream_find(guest)) { plat_mutex_unlock(&stream_lock); ret_x(c, CODEC_R_INVALID); return; }
+    OutputStream *s = calloc(1, sizeof *s);
+    if (!s) rt_fatal("nn::audio: output stream allocation");
+    if (event) kern_bind_system_event(c, event, 1);
+    *s = (OutputStream){.guest = guest, .event = event, .rate = 48000, .capacity = capacity,
+                        .state = STREAM_STOPPED, .next = streams};
+    streams = s;
+    plat_mutex_unlock(&stream_lock);
+    rt_log("audio: virtual output stream, timed sink (%d channels, %d frames)", fmt[1], capacity);
+    ret_x(c, 0);
+}
+static void ov_stream_open(Cpu *c) { stream_open(c, 1); }
+static void ov_stream_open_no_event(Cpu *c) { stream_open(c, 0); }
+
+static int stream_start(OutputStream *s) { // under stream_lock
+    if (!s) return 0;
+    if (s->state == STREAM_STOPPED) {
+        s->state = STREAM_STARTED;
+        s->last_ns = kern_now_ns();
+        if (s->event) kern_signal_system_event(s->event);
+    }
+    return 1;
+}
+static void ov_stream_start(Cpu *c) {
+    plat_mutex_lock(&stream_lock);
+    int ok = stream_start(stream_find(arg_x(c, 0)));
+    plat_mutex_unlock(&stream_lock);
+    ret_x(c, ok ? 0 : CODEC_R_INVALID);
+}
+static void ov_stream_start_many(Cpu *c) {
+    const uint64_t *guests = arg_p(c, 0);
+    int count = (int)arg_x(c, 1);
+    if (count < 0 || (count && !guests)) { ret_x(c, CODEC_R_INVALID); return; }
+    plat_mutex_lock(&stream_lock);
+    int ok = 1;
+    for (int i = 0; i < count; i++) ok &= stream_find(guests[i]) != NULL;
+    if (ok) for (int i = 0; i < count; i++) stream_start(stream_find(guests[i]));
+    plat_mutex_unlock(&stream_lock);
+    ret_x(c, ok ? 0 : CODEC_R_INVALID);
+}
+static void ov_stream_stop(Cpu *c) {
+    plat_mutex_lock(&stream_lock);
+    OutputStream *s = stream_find(arg_x(c, 0));
+    if (s) { stream_drain(s); s->state = STREAM_STOPPED; }
+    plat_mutex_unlock(&stream_lock);
+}
+static void ov_stream_purge(Cpu *c) {
+    plat_mutex_lock(&stream_lock);
+    OutputStream *s = stream_find(arg_x(c, 0));
+    if (s) { s->queued = 0; s->last_ns = kern_now_ns(); }
+    plat_mutex_unlock(&stream_lock);
+}
+static void ov_stream_close(Cpu *c) {
+    uint64_t guest = arg_x(c, 0);
+    plat_mutex_lock(&stream_lock);
+    OutputStream **link = &streams;
+    while (*link && (*link)->guest != guest) link = &(*link)->next;
+    if (*link) {
+        OutputStream *s = *link;
+        *link = s->next;
+        kern_forget_system_event(s->event);
+        free(s);
+    }
+    plat_mutex_unlock(&stream_lock);
+}
+static void ov_stream_state(Cpu *c) {
+    plat_mutex_lock_shared(&stream_lock);
+    OutputStream *s = stream_find(arg_x(c, 0));
+    int state = s ? s->state : 0;
+    plat_mutex_unlock_shared(&stream_lock);
+    ret_x(c, state);
+}
+static void stream_frames(Cpu *c, int filled) {
+    plat_mutex_lock(&stream_lock);
+    OutputStream *s = stream_find(arg_x(c, 0));
+    int frames = 0;
+    if (s) { stream_drain(s); frames = filled ? s->queued : s->capacity - s->queued; }
+    plat_mutex_unlock(&stream_lock);
+    ret_x(c, frames);
+}
+static void ov_stream_free(Cpu *c) { stream_frames(c, 0); }
+static void ov_stream_filled(Cpu *c) { stream_frames(c, 1); }
+static void ov_stream_write(Cpu *c) {
+    int frames = (int)arg_x(c, 2);
+    plat_mutex_lock(&stream_lock);
+    OutputStream *s = stream_find(arg_x(c, 0));
+    if (s) stream_drain(s);
+    if (s && arg_x(c, 1) && frames > 0 && frames <= s->capacity - s->queued) s->queued += frames;
+    else frames = 0;
+    plat_mutex_unlock(&stream_lock);
+    ret_x(c, frames);
+}
+static void ov_stream_gain(Cpu *c) { (void)c; }  // a silent sink has no gain
+static void ov_stream_stats(Cpu *c) {
+    void *out = (void *)(uintptr_t)c->x[8];
+    if (out) memset(out, 0, 24);
+}
